# Health Assistant — example environment.
# Copy to .env.dev or .env.prod and fill in real values.
# Used as seed on first start; afterwards config lives in DB (see spec 15.1).

# --- App ---
APP_ENV=dev
LOG_LEVEL=DEBUG

# --- LLM backend (external, see spec 19.3) ---
# Options: ollama | vllm | mock
LLM_BACKEND=mock
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3.1:8b

# --- Embeddings backend ---
# Options: ollama | tei | infinity | mock
EMBEDDINGS_BACKEND=mock
EMBEDDINGS_BASE_URL=http://host.docker.internal:11434
EMBEDDINGS_MODEL=nomic-embed-text-v2-moe
EMBEDDINGS_DIM=768

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=health
POSTGRES_USER=health
POSTGRES_PASSWORD=health_dev_password

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Auth ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me
# API key for the production /api/chat endpoints (header: Authorization: Bearer <key>).
CHAT_API_KEY=dev_chat_api_key_change_me

# --- Alerts ---
ALERTS_WEBHOOK_URL=

# --- Pipeline thresholds (seed only; later configurable in admin) ---
SESSION_TTL_HOURS=24
LOG_RETENTION_DAYS=30
CONTEXT_HISTORY_PAIRS=10
